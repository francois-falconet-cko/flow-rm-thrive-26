# Checkout.com keys (required on the API server)
CHECKOUT_PUBLIC_KEY=pk_sbox_xxx
CHECKOUT_SECRET_KEY=sk_sbox_xxx

# Public URL of the API server (used for payment success/failure redirects)
APP_BASE_URL=

# Amplify frontend build: URL of the Express API (no trailing slash)
# Example: https://your-api.example.com
API_BASE_URL=

# Comma-separated browser origins allowed to call the API (Amplify URL)
# Example: https://main.d3kx3uukn3tmkj.amplifyapp.com
CORS_ORIGINS=https://main.d3kx3uukn3tmkj.amplifyapp.com

PORT=3000
